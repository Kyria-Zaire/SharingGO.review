# Base Postgres DÉDIÉE aux tests — jamais la base de dev/prod.
# Créer la base : createdb sharinggo_test  (ou via le service postgres du docker-compose)
DATABASE_URL="postgresql://sharinggo:sharinggo@localhost:5432/sharinggo_test"
BOARDING_JWT_SECRET="test-only-boarding-secret-not-for-prod"
STRIPE_SECRET_KEY="sk_test_placeholder"
NODE_ENV="test"

# Requis dès qu'un test importe du code du service layer (src/config/env.ts est validé
# au chargement du module). Valeurs factices — jamais utilisées pour un vrai appel réseau.
PORT="3001"
CORS_ORIGIN="http://localhost:5173"
SESSION_TTL_DAYS="7"
SESSION_COOKIE_NAME="sharinggo_session_test"
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"
STRIPE_WEBHOOK_SECRET="whsec_test_placeholder_0000000000"
STRIPE_SUCCESS_URL="http://localhost:5173/success"
STRIPE_CANCEL_URL="http://localhost:5173/cancel"
STRIPE_TICKET_PRICE_CENTS="1800"
STRIPE_CURRENCY="eur"
STRIPE_PRICE_MOSOLF_MONTHLY="price_test_placeholder"
STRIPE_PRICE_CONVOYEUR_MONTHLY="price_test_placeholder"
STRIPE_SUBSCRIPTION_SUCCESS_URL="http://localhost:5173/subscription/success"
STRIPE_SUBSCRIPTION_CANCEL_URL="http://localhost:5173/subscription/cancel"
GOOGLE_CLIENT_ID="test-client-id.apps.googleusercontent.com"
