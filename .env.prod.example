# =============================================================================
# SharingGO — Production environment template
# =============================================================================
# Usage :
#   1. Copier ce fichier vers /opt/sharinggo/.env.prod sur le VPS
#   2. Remplir toutes les valeurs CHANGEME
#   3. chmod 600 /opt/sharinggo/.env.prod
#   4. chown deploy:deploy /opt/sharinggo/.env.prod  (ou root:root selon stratégie VPS)
#
# NE JAMAIS committer .env.prod — ce fichier d'exemple uniquement.
# .env.prod est gitignored (.gitignore ligne 13).
#
# Variables marquées [REQUIS] : backend refuse de démarrer si absentes.
# Variables marquées [OPTIONNEL] : non consommées par le code en V1,
#   conservées pour usage futur ou tooling externe.
# Variables marquées [BUILD-TIME] : injectées au docker build passenger,
#   pas lues au runtime du container.
# =============================================================================

# =============================================================================
# ENVIRONNEMENT
# =============================================================================

# [REQUIS] Valeur obligatoire en production
NODE_ENV=production

# [REQUIS] Port d'écoute du backend Express
PORT=3000

# [OPTIONNEL] Utilisé par le seed de démo uniquement — forcé false dans compose
ALLOW_DEMO_SEED=false

# [OPTIONNEL] Documentation OpenAPI — forcée false dans compose
ENABLE_API_DOCS=false

# =============================================================================
# POSTGRESQL
# =============================================================================
# Le service postgres Docker utilise ces variables directement.
# DATABASE_URL doit pointer vers le nom du service Docker ("postgres"),
# pas vers localhost.

# [REQUIS par postgres container]
POSTGRES_USER=sharinggo
# [REQUIS par postgres container] Générer : openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME_openssl_rand_base64_32
# [REQUIS par postgres container]
POSTGRES_DB=sharinggo

# [REQUIS] Doit être cohérent avec POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ci-dessus
DATABASE_URL=postgresql://sharinggo:CHANGEME@postgres:5432/sharinggo?schema=public

# =============================================================================
# URLS PRODUCTION
# =============================================================================

# [OPTIONNEL] Référence interne — non consommé par requireEnv en V1
APP_URL=https://sharinggo.fr
ADMIN_URL=https://admin.sharinggo.fr
API_URL=https://api.sharinggo.fr
FRONTEND_URL=https://sharinggo.fr

# =============================================================================
# CORS
# =============================================================================
# [REQUIS] Whitelist explicite — jamais de wildcard * en production.
# Caddy est le seul point d'entrée public, mais le backend valide aussi l'origine.
CORS_ORIGIN=https://sharinggo.fr,https://www.sharinggo.fr,https://admin.sharinggo.fr

# =============================================================================
# SESSIONS
# =============================================================================

# [REQUIS]
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=sharinggo_session

# [NON UTILISÉ V1] Le backend utilise des tokens opaques (randomBytes(32)) stockés
# hashés en DB (table sessions) — le cookie httpOnly n'est PAS signé par express-session.
# SESSION_SECRET n'est lu nulle part dans backend/src/.
# Conserver si migration vers express-session ou cookies signés (S1+).
# SESSION_SECRET=

# =============================================================================
# ARGON2 (hachage mots de passe)
# =============================================================================
# [REQUIS] Ne pas réduire ces valeurs en production.

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# =============================================================================
# JWT
# =============================================================================

# [NON UTILISÉ V1] BOARDING_JWT_SECRET (HS256) est le seul secret JWT actif.
# JWT_PRIVATE_KEY est réservé pour la migration vers RS256/EdDSA documentée dans
# boarding-offline.constants.ts (BOARDING_JWT_ALGORITHMS_TARGET).
# Pas câblé dans backend/src/ en V1.
# JWT_PRIVATE_KEY=

# =============================================================================
# BOARDING QR (HS256)
# =============================================================================
# [REQUIS] Minimum 32 caractères — requireEnv() + validation length dans backend/src/config/env.ts.
# Le backend refuse de démarrer si absent ou < 32 chars.
# Générer : openssl rand -base64 48  (ou via scripts/generate-secrets.sh)
BOARDING_JWT_SECRET=CHANGEME_openssl_rand_base64_48

# =============================================================================
# GOOGLE OAUTH (convoyeur — authentification Google One Tap backend)
# =============================================================================
# Source : Google Cloud Console → APIs & Services → Credentials
#
# Origine autorisée à configurer dans Google Console :
#   https://sharinggo.fr
#   https://admin.sharinggo.fr
#
# URI de redirection à configurer dans Google Console :
#   https://api.sharinggo.fr/api/auth/google/callback
#
# VITE_GOOGLE_CLIENT_ID (section BUILD-TIME ci-dessous) doit avoir
# la même valeur que GOOGLE_CLIENT_ID.

# [REQUIS] Format attendu : xxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com

# [NON UTILISÉ V1] Le flow Google est ID token (One Tap côté passenger) — le backend
# vérifie le token JWT avec OAuth2Client.verifyIdToken() qui ne nécessite pas le client secret.
# Pas de code exchange serveur, pas de redirect OAuth.
# Conserver si migration vers Authorization Code Flow serveur prévue (S2+).
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.sharinggo.fr/api/auth/google/callback

# =============================================================================
# STRIPE — LIVE MODE
# =============================================================================
# ATTENTION : utiliser les clés LIVE (sk_live_*) — jamais les clés TEST (sk_test_*).
# Les Price IDs test (price_1TaCv...) ne fonctionnent pas avec les clés live.
# Créer des Price IDs dédiés dans le Dashboard Stripe en mode LIVE.
#
# Dashboard Stripe → Développeurs → Clés API
# Dashboard Stripe → Webhooks → Ajouter un endpoint
#
# Endpoint webhook à enregistrer dans le Dashboard Stripe :
#   https://api.sharinggo.fr/api/webhooks/stripe
#
# Événements Stripe à activer sur l'endpoint :
#   checkout.session.completed
#   checkout.session.expired
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_succeeded
#   invoice.payment_failed

# [REQUIS] Clé secrète live — Dashboard Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_live_CHANGEME

# [REQUIS] Secret webhook live — Dashboard Stripe → Webhooks → endpoint créé ci-dessus
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# [REQUIS] 899 = 8,99 € TTC — ne pas modifier sans validation CTO
STRIPE_TICKET_PRICE_CENTS=899
STRIPE_CURRENCY=eur

# [REQUIS] URLs de redirection post-paiement
STRIPE_SUCCESS_URL=https://sharinggo.fr/bookings/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://sharinggo.fr/bookings/payment/cancel

# =============================================================================
# STRIPE BILLING (abonnements convoyeurs/Mosolf)
# =============================================================================
# [REQUIS] Price IDs LIVE — à créer dans Dashboard Stripe → Produits (mode Live)
# NE PAS réutiliser les price_ de test (price_1TaCv..., price_1Tmg4P...).
# Ces IDs test ne fonctionnent qu'avec sk_test_* et sont invalides en live.

STRIPE_PRICE_MOSOLF_MONTHLY=price_live_CHANGEME
STRIPE_PRICE_CONVOYEUR_MONTHLY=price_live_CHANGEME

# [REQUIS] URLs de redirection post-abonnement
STRIPE_SUBSCRIPTION_SUCCESS_URL=https://admin.sharinggo.fr/subscription/success
STRIPE_SUBSCRIPTION_CANCEL_URL=https://admin.sharinggo.fr/subscription/cancel

# =============================================================================
# CLOUDFLARE TURNSTILE
# =============================================================================
# Dashboard Cloudflare → Turnstile → Créer un widget
# Domaines autorisés : sharinggo.fr, admin.sharinggo.fr
#
# Note : Turnstile est validé côté backend uniquement.
# Le frontend passenger ne charge pas de script Turnstile (confirmé).

# [OPTIONNEL selon activation — non dans requireEnv en V1]
CLOUDFLARE_TURNSTILE_SITE_KEY=CHANGEME
CLOUDFLARE_TURNSTILE_SECRET_KEY=CHANGEME

# =============================================================================
# FRONTEND PASSENGER — BUILD-TIME VITE
# =============================================================================
# Ces variables sont injectées au moment du docker build (ARG dans Dockerfile),
# pas lues au runtime du container nginx.
# Elles sont passées via les `args:` du service passenger dans docker-compose.prod.yml.
# Modifier ici n'a aucun effet sans rebuild du container passenger.

# [BUILD-TIME] URL de l'API backend — inlinée dans le bundle Vite
VITE_API_URL=https://api.sharinggo.fr

# [BUILD-TIME] Google One Tap côté passenger — même valeur que GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com

# =============================================================================
# MONITORING
# =============================================================================

# [OPTIONNEL] Sentry DSN backend — Dashboard Sentry → Settings → SDK Setup
SENTRY_DSN=https://CHANGEME@oXXXXXX.ingest.sentry.io/XXXXXXX
