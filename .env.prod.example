# =============================================================================
# SharingGO — Production environment (template)
# Copier vers .env.prod sur le VPS, compléter, chmod 600
# NE JAMAIS committer .env.prod — ce fichier d'exemple uniquement
# =============================================================================

# --- Environnement ---
APP_ENV=prod
NODE_ENV=production
PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=sharinggo
POSTGRES_PASSWORD=CHANGEME_openssl_rand_base64_32
POSTGRES_DB=sharinggo
# DATABASE_URL pointe vers le service Docker interne (nom du service = postgres)
DATABASE_URL=postgresql://sharinggo:CHANGEME@postgres:5432/sharinggo?schema=public

# --- API ---
# false obligatoire en production
ENABLE_API_DOCS=false
# false obligatoire en production
ALLOW_DEMO_SEED=false
API_URL=https://api.sharinggo.fr
FRONTEND_URL=https://sharinggo.fr

# --- CORS (whitelist des origines autorisées — pas de wildcard) ---
CORS_ORIGIN=https://sharinggo.fr,https://www.sharinggo.fr,https://admin.sharinggo.fr

# --- Sessions ---
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=sharinggo_session
SESSION_SECRET=CHANGEME_openssl_rand_base64_48

# --- Argon2 (hachage mots de passe) ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- JWT (tokens internes) ---
JWT_PRIVATE_KEY=CHANGEME_openssl_rand_base64_48

# --- Boarding QR (HS256 — minimum 32 caractères) ---
BOARDING_JWT_SECRET=CHANGEME_openssl_rand_base64_48

# --- Google OAuth (convoyeur — Google Cloud Console) ---
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME
GOOGLE_CALLBACK_URL=https://api.sharinggo.fr/api/auth/google/callback

# --- Stripe (Live — Dashboard Stripe → Développeurs → Clés API) ---
# Utiliser sk_live_* en production — jamais sk_test_*
STRIPE_SECRET_KEY=sk_live_CHANGEME
# Endpoint webhook prod créé dans Dashboard Stripe → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
STRIPE_SUCCESS_URL=https://sharinggo.fr/bookings/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://sharinggo.fr/bookings/payment/cancel
# 899 = 8,99 €
STRIPE_TICKET_PRICE_CENTS=899
STRIPE_CURRENCY=eur

# --- Stripe Billing (abonnements — Dashboard Stripe → Produits) ---
# Créer des price_ PROD distincts — ne jamais copier les price_ test
STRIPE_PRICE_MOSOLF_MONTHLY=price_live_CHANGEME
STRIPE_PRICE_CONVOYEUR_MONTHLY=price_live_CHANGEME
STRIPE_SUBSCRIPTION_SUCCESS_URL=https://admin.sharinggo.fr/subscription/success
STRIPE_SUBSCRIPTION_CANCEL_URL=https://admin.sharinggo.fr/subscription/cancel

# --- Cloudflare Turnstile (Dashboard Cloudflare → Turnstile) ---
CLOUDFLARE_TURNSTILE_SITE_KEY=CHANGEME
CLOUDFLARE_TURNSTILE_SECRET_KEY=CHANGEME

# --- Frontend passenger (build-time Vite — injectée au docker build, pas au runtime) ---
# VITE_API_URL : URL de l'API backend (inlinée dans le bundle par Vite)
VITE_API_URL=https://api.sharinggo.fr
# VITE_GOOGLE_CLIENT_ID : Google One Tap OAuth côté passenger
# Même valeur que GOOGLE_CLIENT_ID backend (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com

# --- Monitoring ---
# Sentry DSN — Dashboard Sentry → Paramètres projet → SDK Setup
SENTRY_DSN=https://CHANGEME@oXXXXXX.ingest.sentry.io/XXXXXXX
