# =============================================================================
# Sharing Go — variables d'environnement (copier vers .env, ne jamais committer)
# =============================================================================

APP_ENV=dev
NODE_ENV=development

# --- PostgreSQL (docker-compose: service `postgres`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharinggo
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sharinggo?schema=public

# Backend (hôte local hors Docker: localhost au lieu de postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharinggo?schema=public

# --- API ---
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Auth / sessions (S0-T4+) ---
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=sharinggo_session
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Reserved for future tickets (not used in S0-T4)
SESSION_SECRET=change-me-min-32-chars-dev-only
JWT_PRIVATE_KEY=change-me-jwt-signing-dev-only

# --- Google OAuth (convoyeur — S0-T2+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Stripe (S1-T4 — ticket unique 8 EUR) ---
# Secret key only (sk_test_...) — NOT the publishable key (pk_test_...)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel
STRIPE_TICKET_PRICE_CENTS=800
STRIPE_CURRENCY=eur

# Reserved for future tickets (subscriptions / Mosolf)
STRIPE_PRICE_TICKET=
STRIPE_PRICE_SUB_CONV=
STRIPE_PRICE_SUB_MOSOLF=

# --- Cloudflare Turnstile (S0-T2+) ---
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
