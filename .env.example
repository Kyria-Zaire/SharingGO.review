# =============================================================================
# Sharing Go — variables d'environnement (copier vers .env, ne jamais committer)
# =============================================================================

APP_ENV=dev
NODE_ENV=development

# --- PostgreSQL (docker-compose: service `postgres`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharinggo
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sharinggo?schema=public

# Backend (hôte local hors Docker: localhost au lieu de postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharinggo?schema=public

# --- API ---
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Auth / sessions (S0-T2+) ---
SESSION_SECRET=change-me-min-32-chars-dev-only
JWT_PRIVATE_KEY=change-me-jwt-signing-dev-only

# --- Google OAuth (convoyeur — S0-T2+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Stripe (S0-T3+) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_TICKET=
STRIPE_PRICE_SUB_CONV=
STRIPE_PRICE_SUB_MOSOLF=

# --- Cloudflare Turnstile (S0-T2+) ---
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
