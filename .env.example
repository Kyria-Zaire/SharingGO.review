# =============================================================================
# Sharing Go — variables d'environnement (copier vers .env, ne jamais committer)
# =============================================================================

# APP_ENV=dev  # non lu par le backend V1 — conservé pour tooling futur
NODE_ENV=development

# --- PostgreSQL (docker-compose: service `postgres`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sharinggo
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sharinggo?schema=public

# Backend (hôte local hors Docker: localhost au lieu de postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharinggo?schema=public

# --- API ---
PORT=3000
# OpenAPI / Swagger UI (GET /api/docs, /api/docs.json) — true en dev, false recommandé en prod
ENABLE_API_DOCS=true

# Demo seed (npm run db:seed:demo) — true uniquement en local pour charger @sharinggo.demo
ALLOW_DEMO_SEED=false
# API_URL / FRONTEND_URL — non lus par backend/src en V1 (référence ops uniquement)
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Admin cockpit :5173 · Passenger app :5174 (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Auth / sessions (S0-T4+) ---
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=sharinggo_session
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Non utilisés V1 — cookies opaques hashés en DB, pas express-session
# SESSION_SECRET=change-me-min-32-chars-dev-only
# JWT_PRIVATE_KEY=change-me-jwt-signing-dev-only

# --- Boarding JWT (S2-T1 — QR boarding token foundation) ---
# HS256 secret for signed boarding JWTs (never store JWT in DB)
BOARDING_JWT_SECRET=change-me-boarding-jwt-min-32-chars-dev-only

# --- Google OAuth (convoyeur — F4A-T5A+) ---
# Flow V1 : One Tap ID token — pas de redirect OAuth serveur
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Stripe (S1-T4 — ticket unitaire 8,99 EUR TTC) ---
# Secret key only (sk_test_...) — NOT the publishable key (pk_test_...)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:5174/bookings/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5174/bookings/payment/cancel
STRIPE_TICKET_PRICE_CENTS=899
STRIPE_CURRENCY=eur

# --- Stripe Billing subscriptions (S2-T8B) ---
# Recurring monthly Price ids (Dashboard → Products → Add price → Recurring)
# DEV: utiliser sk_test_* + price_ test dédiés
# PROD: sk_live_* + NOUVEAUX price_ prod (ne jamais copier les price_ de test)
STRIPE_PRICE_MOSOLF_MONTHLY=price_1TaCvQJoKcqsGQTGAaFTm1ZM
STRIPE_PRICE_CONVOYEUR_MONTHLY=price_1Tmg4PJoKcqsGQTGcUUEwFPr
STRIPE_SUBSCRIPTION_SUCCESS_URL=http://localhost:5174/subscriptions
STRIPE_SUBSCRIPTION_CANCEL_URL=http://localhost:5174/subscriptions

# --- Cloudflare Turnstile (S0-T2+) — non câblé backend V1 ---
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
# Passenger Google One Tap — même valeur que GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
