# Passenger app (Vite) — copier vers .env local, ne jamais committer
# Port dev par défaut : 5174 (admin cockpit : 5173)

VITE_API_URL=http://localhost:3000

# Google OAuth — même client ID que GOOGLE_CLIENT_ID backend (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# robots.txt — généré dans public/ via pnpm generate:robots (prebuild automatique)
# Défaut local / non-prod : disallow. CI PROD : ROBOTS_POLICY=allow
ROBOTS_POLICY=disallow
PUBLIC_SITE_URL=https://sharinggo.fr
